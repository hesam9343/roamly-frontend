.auth-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(101, 230, 174, 0.1),
      transparent 35%
    ),
    #07100d;
  color: #f4f8f6;
}

.auth-glow {
  position: absolute;
  width: 500px;
  height: 500px;
  top: -250px;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: rgba(101, 230, 174, 0.08);
  filter: blur(80px);
  pointer-events: none;
}

.auth-logo {
  position: absolute;
  top: 28px;
  left: 32px;
  color: #ffffff;
  font-family: "Space Grotesk", sans-serif;
  font-size: 1.5rem;
  font-weight: 700;
  text-decoration: none;
}

.auth-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 90px 20px 40px;
}

.auth-card {
  width: min(440px, 100%);
  padding: 42px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.045);
  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(20px);
}

.auth-header {
  margin-bottom: 30px;
}

.auth-eyebrow {
  color: #65e6ae;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.15em;
}

.auth-header h1 {
  margin: 12px 0 10px;
  font-family: "Space Grotesk", sans-serif;
  font-size: 2.7rem;
  line-height: 1;
  letter-spacing: -0.04em;
}

.auth-header p {
  margin: 0;
  color: #84938c;
  line-height: 1.6;
}

.auth-error {
  margin-bottom: 20px;
  padding: 13px 15px;
  border: 1px solid rgba(255, 100, 100, 0.2);
  border-radius: 10px;
  background: rgba(255, 80, 80, 0.08);
  color: #ff9d9d;
  font-size: 0.9rem;
  line-height: 1.5;
}

.auth-field {
  display: block;
  margin-bottom: 18px;
}

.auth-field > span {
  display: block;
  margin-bottom: 8px;
  color: #c8d3ce;
  font-size: 0.86rem;
  font-weight: 600;
}

.auth-field input {
  width: 100%;
  box-sizing: border-box;
  min-height: 52px;
  padding: 0 15px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 12px;
  outline: none;
  background: rgba(0, 0, 0, 0.18);
  color: #ffffff;
  font: inherit;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}
   

   .auth-field input,
.auth-field select {
  width: 100%;
  box-sizing: border-box;
  min-height: 52px;
  padding: 0 15px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 12px;
  outline: none;
  background: rgba(0, 0, 0, 0.18);
  color: #ffffff;
  font: inherit;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.auth-field input::placeholder {
  color: #56645e;
}

.auth-field select {
  cursor: pointer;
}

.auth-field select option {
  background: #07100d;
  color: #ffffff;
}

.auth-field input:focus,
.auth-field select:focus {
  border-color: rgba(101, 230, 174, 0.55);
  box-shadow: 0 0 0 3px rgba(101, 230, 174, 0.08);
}

.auth-submit {
  width: 100%;
  min-height: 54px;
  margin-top: 8px;
  border: none;
  border-radius: 12px;
  background: #65e6ae;
  color: #07100d;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    opacity 0.2s ease;
}

.auth-submit:hover:not(:disabled) {
  transform: translateY(-1px);
}

.auth-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.auth-divider {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 26px 0;
  color: #56645e;
  font-size: 0.8rem;
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  height: 1px;
  flex: 1;
  background: rgba(255, 255, 255, 0.07);
}

.auth-switch {
  width: 100%;
  padding: 0;
  border: none;
  background: transparent;
  color: #a9b8b2;
  font: inherit;
  cursor: pointer;
}

.auth-switch:hover {
  color: #65e6ae;
}

@media (max-width: 600px) {
  .auth-logo {
    top: 20px;
    left: 20px;
  }

  .auth-container {
    padding: 80px 14px 25px;
  }

  .auth-card {
    padding: 30px 22px;
    border-radius: 20px;
  }

  .auth-header h1 {
    font-size: 2.3rem;
  }
}

/* Final Back button */
.auth-back-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 38px;
  padding: 0 13px;
  border: 1px solid rgba(255, 255, 255, 0.11);
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.045);
  color: #fff;
  font: inherit;
  font-size: 13px;
  line-height: 1;
  cursor: pointer;
  transition: background 140ms ease, border-color 140ms ease, transform 140ms ease;
}

.auth-back-button:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.17);
}

.auth-back-button:active {
  transform: translateY(1px);
}

.auth-back-button:focus-visible {
  outline: 2px solid rgba(74, 150, 117, 0.42);
  outline-offset: 2px;
}

@media (max-width: 600px) {
  .auth-back-button {
    min-height: 35px;
    padding: 0 11px;
    border-radius: 8px;
    font-size: 12px;
  }
}
