}

.home-hero-image::after {
  content: "";
  position: absolute;
  width: 510px;
  height: 180px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-22deg);
  border: 1px solid rgba(101, 230, 174, 0.1);
  border-radius: 50%;
}

.home-image-overlay {
  position: absolute;
  inset: 0;
