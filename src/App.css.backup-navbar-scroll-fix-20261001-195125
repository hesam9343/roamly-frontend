  border-radius: 28px;
  background:
    radial-gradient(circle at 68% 27%, rgba(101, 230, 174, 0.22), transparent 23%),
    radial-gradient(circle at 25% 72%, rgba(101, 230, 174, 0.1), transparent 30%),
    linear-gradient(145deg, #162b23 0%, #0b1713 48%, #07100d 100%);
  box-shadow:
    0 35px 100px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

.home-hero-image::before {
  content: "";
  position: absolute;
  width: 360px;
  height: 360px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border: 1px solid rgba(101, 230, 174, 0.17);
  border-radius: 50%;
