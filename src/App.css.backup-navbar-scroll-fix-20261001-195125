  transform: translateY(-1px);
}

.home-page .nav-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-left: auto;
}

.home-page .nav-links a {
  position: relative;
  display: inline-flex;
  align-items: center;

  min-height: 40px;
  padding: 0 14px;

  color: rgba(235, 241, 242, 0.68);
  text-decoration: none;

  font-size: 13px;
  font-weight: 650;
  letter-spacing: 0.01em;

  border-radius: 10px;
  transition:
    color 0.2s ease,
    background 0.2s ease;
}

.home-page .nav-links a::after {
  display: none;
}

.home-page .nav-links a:hover {
  color: #f4f7f8;
  background: rgba(255, 255, 255, 0.055);
}

.home-page .nav-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex-shrink: 0;
}

.home-page .nav-chat,
.home-page .nav-notifications,
.home-page .nav-user,
.home-page .nav-logout,
.home-page .login-button,
.home-page .signup-button {
  min-height: 40px;
  border-radius: 10px;
}

.home-page .nav-chat,
.home-page .nav-notifications {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: 40px;
  padding: 0;

  color: rgba(235, 241, 242, 0.72);
  text-decoration: none;

  background: transparent;
  border: 1px solid transparent;

  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.home-page .nav-chat:hover,
.home-page .nav-notifications:hover {
  color: #f4f7f8;
  background: rgba(255, 255, 255, 0.055);
  border-color: rgba(255, 255, 255, 0.07);
  transform: translateY(-1px);
}

.home-page .nav-chat-badge,
.home-page .nav-notifications-badge {
  position: absolute;
  top: 4px;
  right: 3px;

  min-width: 16px;
  height: 16px;
  padding: 0 4px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #07110d;
  background: #70d6a1;
  border: 2px solid #0a1018;
  border-radius: 999px;

  font-size: 9px;
  font-weight: 800;
  line-height: 1;
}

.home-page .nav-user {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 0 11px;

  color: rgba(235, 241, 242, 0.75);
  text-decoration: none;

  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.065);

  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}

.home-page .nav-user:hover {
  color: #f4f7f8;
  background: rgba(255, 255, 255, 0.065);
  border-color: rgba(255, 255, 255, 0.1);
}

.home-page .nav-user span:last-child {
  font-size: 12px;
  font-weight: 650;
}

.home-page .nav-user-dot {
  width: 7px;
  height: 7px;
  flex-shrink: 0;

  border-radius: 50%;
  background: #70d6a1;
  box-shadow: 0 0 0 3px rgba(112, 214, 161, 0.1);
}

.home-page .nav-logout {
  padding: 0 12px;

  color: rgba(235, 241, 242, 0.6);
  background: transparent;
  border: 1px solid transparent;

  font-size: 12px;
  font-weight: 650;

  cursor: pointer;

  transition:
    color 0.2s ease,
    background 0.2s ease;
}

.home-page .nav-logout:hover {
  color: #f4f7f8;
  background: rgba(255, 255, 255, 0.055);
}

.home-page .login-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 14px;

  color: rgba(242, 247, 247, 0.78);
  text-decoration: none;

  font-size: 12px;
  font-weight: 700;

  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.035);

  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.home-page .login-button:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(255, 255, 255, 0.13);
  transform: translateY(-1px);
}

.home-page .signup-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 16px;

  color: #07110d;
  text-decoration: none;

  background: #70d6a1;
  border: 1px solid rgba(255, 255, 255, 0.18);

  font-size: 12px;
  font-weight: 800;

  box-shadow: 0 8px 22px rgba(112, 214, 161, 0.12);

  transition:
    background 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.home-page .signup-button:hover {
  background: #82dfae;
  transform: translateY(-1px);
  box-shadow: 0 11px 26px rgba(112, 214, 161, 0.18);
}

/* Mobile */
@media (max-width: 760px) {
  .home-page .navbar {
    padding-top: 12px;
  }

  .home-page .navbar-top {
    width: calc(100% - 24px);
    min-height: 58px;
    padding: 8px 9px 8px 13px;
    gap: 8px;
    border-radius: 15px;
  }

  .home-page .logo {
    font-size: 19px;
  }

  .home-page .nav-links {
    margin-left: 0;
  }

  .home-page .nav-links a {
    min-height: 36px;
    padding: 0 9px;
    font-size: 12px;
  }

  .home-page .nav-actions {
    gap: 4px;
  }

  .home-page .nav-chat,
  .home-page .nav-notifications {
    width: 36px;
    min-height: 36px;
  }

  .home-page .nav-user {
    min-height: 36px;
    padding: 0 9px;
  }

  .home-page .nav-user span:last-child {
    display: none;
  }

  .home-page .nav-logout,
  .home-page .login-button {
    display: none;
  }

  .home-page .signup-button {
    min-height: 36px;
    padding: 0 11px;
    font-size: 11px;
  }
}

@media (max-width: 480px) {
  .home-page .navbar-top {
    width: calc(100% - 16px);
  }

  .home-page .nav-links a {
    padding: 0 7px;
    font-size: 11px;
  }

  .home-page .nav-chat,
  .home-page .nav-notifications {
    display: none;
  }
}


/* =========================================================
   ROAMLY — MOBILE ACCOUNT MENU
   ========================================================= */

.desktop-nav-account,
.desktop-nav-auth,
.mobile-menu-button,
.mobile-account-menu {
  display: none;
}

@media (max-width: 760px) {
  .home-page .desktop-nav-account,
  .home-page .desktop-nav-auth {
    display: none;
  }

  .home-page .mobile-menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    min-height: 36px;
    padding: 0 11px;

    color: rgba(242, 247, 247, 0.84);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;

    font: inherit;
    font-size: 11px;
    font-weight: 750;

    cursor: pointer;

    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .home-page .mobile-menu-button:hover,
  .home-page .mobile-menu-button[aria-expanded="true"] {
    color: #fff;
    background: rgba(255, 255, 255, 0.075);
    border-color: rgba(255, 255, 255, 0.13);
  }

  .home-page .mobile-menu-button .nav-user-dot {
    width: 6px;
    height: 6px;
    margin: 0;
  }

  .home-page .mobile-account-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;

    display: flex;
    flex-direction: column;

    width: 190px;
    padding: 7px;

    background: rgba(11, 17, 25, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;

    box-shadow:
      0 20px 45px rgba(0, 0, 0, 0.32),
      inset 0 1px 0 rgba(255, 255, 255, 0.035);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    z-index: 100;
  }

  .home-page .mobile-account-menu a,
  .home-page .mobile-account-menu button {
    min-height: 42px;
    width: 100%;
    padding: 0 11px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    color: rgba(240, 245, 245, 0.78);
    background: transparent;
    border: 0;
    border-radius: 9px;

    text-decoration: none;
    font: inherit;
    font-size: 12px;
    font-weight: 650;
    text-align: left;

    cursor: pointer;

    transition:
      color 0.18s ease,
      background 0.18s ease;
  }

  .home-page .mobile-account-menu a:hover,
  .home-page .mobile-account-menu button:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }

  .home-page .mobile-account-menu button {
    color: rgba(240, 245, 245, 0.58);
  }

  .home-page .mobile-menu-badge {
    min-width: 18px;
    height: 18px;
    padding: 0 5px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    color: #07110d;
    background: #70d6a1;
    border-radius: 999px;

    font-size: 9px;
    font-weight: 800;
    line-height: 1;
  }

  .home-page .nav-actions {
    position: relative;
  }

  .home-page .nav-links {
    flex: 1;
    justify-content: center;
  }

  .home-page .nav-links a {
    white-space: nowrap;
  }
}

@media (max-width: 480px) {
  .home-page .nav-links {
    gap: 2px;
  }

  .home-page .nav-links a {
    padding: 0 6px;
    font-size: 10.5px;
  }

  .home-page .nav-chat,
  .home-page .nav-notifications {
    display: none;
  }

  .home-page .mobile-menu-button {
    padding: 0 9px;
  }
}

