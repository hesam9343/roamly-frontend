.chat-page {
  min-height: 100vh;
  padding: 32px 24px 40px;

  color: #f5f7fa;

  background:
    radial-gradient(
      circle at 12% 8%,
      rgba(101, 230, 174, 0.08),
      transparent 27%
    ),
    radial-gradient(
      circle at 90% 88%,
      rgba(45, 105, 255, 0.055),
      transparent 30%
    ),
    #07100d;
}

/* SHELL */

.chat-shell {
  position: relative;

  width: min(1180px, 100%);
  height: calc(100vh - 72px);
  min-height: 600px;

  margin: 0 auto;

  display: grid;
  grid-template-columns: 350px minmax(0, 1fr);

  overflow: hidden;

  border: 1px solid rgba(255, 255, 255, 0.085);
  border-radius: 28px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.045),
      rgba(255, 255, 255, 0.012)
    );

  box-shadow:
    0 35px 100px rgba(0, 0, 0, 0.32),
    inset 0 1px 0 rgba(255, 255, 255, 0.045);
}

/* SIDEBAR */

.chat-sidebar {
  position: relative;

  display: flex;
  flex-direction: column;
  min-width: 0;

  border-right: 1px solid rgba(255, 255, 255, 0.07);

  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(101, 230, 174, 0.045),
      transparent 30%
    ),
    rgba(7, 13, 11, 0.86);
}

.chat-sidebar::after {
  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  right: -100px;
  bottom: -80px;

  border: 1px solid rgba(101, 230, 174, 0.055);
  border-radius: 50%;

  pointer-events: none;
}

/* SIDEBAR HEADER */

.chat-sidebar-header {
  position: relative;

  padding: 27px 23px 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid rgba(255, 255, 255, 0.055);
}

.chat-eyebrow {
  display: block;

  color: rgba(101, 230, 174, 0.78);

  font-family: "Space Grotesk", sans-serif;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.8px;
}

.chat-sidebar-header h1 {
  margin-top: 6px;

  font-family: "Space Grotesk", sans-serif;
  font-size: 27px;
  line-height: 1;

  letter-spacing: -1.2px;
}

.chat-online-dot {
  width: 8px;
  height: 8px;

  flex: 0 0 auto;

  border-radius: 50%;

  background: #65e6ae;

  box-shadow:
    0 0 0 4px rgba(101, 230, 174, 0.055),
    0 0 18px rgba(101, 230, 174, 0.65);
}

/* SEARCH */

.chat-search {
  height: 46px;

  margin: 16px 15px 12px;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 0 13px;

  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 13px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.045),
      rgba(255, 255, 255, 0.02)
    );

  transition:
    border-color 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.chat-search:focus-within {
  border-color: rgba(101, 230, 174, 0.22);

  background: rgba(255, 255, 255, 0.045);

  box-shadow:
    0 0 0 3px rgba(101, 230, 174, 0.035);
}

.chat-search span {
  color: rgba(245, 247, 250, 0.36);

  font-size: 17px;
  line-height: 1;
}

.chat-search input {
  width: 100%;

  border: 0;
  outline: 0;

  color: #f5f7fa;
  background: transparent;

  font-family: inherit;
  font-size: 12px;
}

.chat-search input::placeholder {
  color: rgba(245, 247, 250, 0.29);
}

/* CONVERSATIONS */

.chat-conversation-list {
  flex: 1;

  min-height: 0;

  overflow-y: auto;

  padding: 4px 9px 15px;

  scrollbar-width: thin;
  scrollbar-color:
    rgba(255, 255, 255, 0.12)
    transparent;
}

.conversation-item {
  position: relative;

  width: 100%;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 12px 11px;
  margin-bottom: 3px;

  border: 1px solid transparent;
  border-radius: 15px;

  background: transparent;

  color: inherit;

  text-align: left;

  cursor: pointer;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.conversation-item:hover {
  background: rgba(255, 255, 255, 0.035);

  border-color: rgba(255, 255, 255, 0.035);
}

.conversation-item-active {
  background:
    linear-gradient(
      135deg,
      rgba(101, 230, 174, 0.09),
      rgba(101, 230, 174, 0.025)
    );

  border-color: rgba(101, 230, 174, 0.095);
}

.conversation-item-active::before {
  content: "";

  position: absolute;

  left: -1px;
  top: 13px;
  bottom: 13px;

  width: 2px;

  border-radius: 999px;

  background: #65e6ae;

  box-shadow: 0 0 12px rgba(101, 230, 174, 0.5);
}

/* AVATARS */

.conversation-avatar,
.chat-header-avatar {
  position: relative;

  flex: 0 0 auto;

  display: grid;
  place-items: center;

  width: 45px;
  height: 45px;

  overflow: hidden;

  border: 1px solid rgba(101, 230, 174, 0.13);
  border-radius: 14px;

  color: #65e6ae;

  background:
    radial-gradient(
      circle at 30% 20%,
      rgba(255, 255, 255, 0.08),
      transparent 25%
    ),
    linear-gradient(
      145deg,
      rgba(101, 230, 174, 0.16),
      rgba(101, 230, 174, 0.025)
    );

  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.045);
}

.conversation-avatar img,
.chat-header-avatar img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}

/* CONVERSATION CONTENT */

.conversation-main {
  min-width: 0;
  flex: 1;
}

.conversation-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.conversation-top strong {
  overflow: hidden;

  color: rgba(255, 255, 255, 0.82);

  font-size: 12px;
  font-weight: 700;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-top-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;

  margin-left: auto;

  flex-shrink: 0;
}

.conversation-top-right > span:first-child {
  color: rgba(245, 247, 250, 0.3);

  font-size: 9px;
}

.conversation-preview {
  margin-top: 5px;

  overflow: hidden;

  color: rgba(245, 247, 250, 0.34);

  font-size: 10px;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-unread {
  min-width: 19px;
  height: 18px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 5px;

  border: 1px solid rgba(101, 230, 174, 0.15);
  border-radius: 999px;

  color: #07100d;

  background: #65e6ae;

  font-size: 9px;
  font-weight: 800;

  line-height: 1;

  box-shadow:
    0 4px 14px rgba(101, 230, 174, 0.12);
}

/* CHAT PANEL */

.chat-panel {
  position: relative;

  min-width: 0;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 78% 0%,
      rgba(101, 230, 174, 0.055),
      transparent 32%
    ),
    radial-gradient(
      circle at 20% 100%,
      rgba(40, 90, 255, 0.035),
      transparent 28%
    ),
    #09100d;
}

.chat-panel::before {
  content: "";

  position: absolute;

  width: 260px;
  height: 260px;

  right: -160px;
  top: -170px;

  border: 1px solid rgba(101, 230, 174, 0.05);
  border-radius: 50%;

  pointer-events: none;
}

/* WELCOME */

.chat-welcome {
  position: relative;

  flex: 1;

  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;

  padding: 40px;

  text-align: center;
}

.chat-welcome-orb {
  position: relative;

  width: 96px;
  height: 96px;

  display: grid;
  place-items: center;

  margin-bottom: 25px;

  border: 1px solid rgba(101, 230, 174, 0.16);
  border-radius: 30px;

  background:
    radial-gradient(
      circle at 35% 25%,
      rgba(255, 255, 255, 0.08),
      transparent 24%
    ),
    radial-gradient(
      circle,
      rgba(101, 230, 174, 0.12),
      rgba(101, 230, 174, 0.025) 65%,
      transparent
    );

  box-shadow:
    0 0 55px rgba(101, 230, 174, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

.chat-welcome-orb::before,
.chat-welcome-orb::after {
  content: "";

  position: absolute;

  border: 1px solid rgba(101, 230, 174, 0.09);
  border-radius: 50%;

  pointer-events: none;
}

.chat-welcome-orb::before {
  width: 128px;
  height: 46px;

  transform: rotateX(65deg) rotateZ(-18deg);
}

.chat-welcome-orb::after {
  width: 80px;
  height: 125px;

  transform: rotateX(65deg) rotateZ(18deg);
}

.chat-welcome-orb span {
  position: relative;
  z-index: 2;

  color: #65e6ae;

  font-size: 28px;
}

.chat-welcome h2 {
  margin: 0;

  font-family: "Space Grotesk", sans-serif;

  font-size: 26px;
  letter-spacing: -1px;
}

.chat-welcome p {
  max-width: 370px;

  margin: 11px 0 0;

  color: rgba(245, 247, 250, 0.4);

  font-size: 12px;
  line-height: 1.75;
}

/* HEADER */

.chat-header {
  position: relative;
  z-index: 2;

  min-height: 78px;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 12px 19px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.065);

  background:
    linear-gradient(
      180deg,
      rgba(11, 17, 14, 0.9),
      rgba(11, 17, 14, 0.74)
    );

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.chat-header-avatar {
  width: 44px;
  height: 44px;

  border-radius: 13px;
}

.chat-header-info {
  min-width: 0;
  flex: 1;
}

.chat-header-info strong {
  display: block;

  overflow: hidden;

  color: rgba(255, 255, 255, 0.87);

  font-size: 13px;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-header-info span {
  display: block;

  margin-top: 4px;

  color: rgba(245, 247, 250, 0.32);

  font-size: 9px;
}

.chat-back-button,
.chat-more-button {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  border: 1px solid transparent;
  border-radius: 11px;

  color: rgba(245, 247, 250, 0.58);

  background: transparent;

  font-size: 19px;

  cursor: pointer;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}

.chat-back-button {
  display: none;
}

.chat-more-button:hover,
.chat-back-button:hover {
  color: #ffffff;

  background: rgba(255, 255, 255, 0.045);

  border-color: rgba(255, 255, 255, 0.055);
}

/* MESSAGES */

.chat-messages {
  position: relative;
  z-index: 1;

  flex: 1;

  min-height: 0;

  overflow-y: auto;

  padding: 26px 24px;

  scroll-behavior: smooth;

  scrollbar-width: thin;
  scrollbar-color:
    rgba(255, 255, 255, 0.11)
    transparent;
}

.message-row {
  display: flex;

  margin-bottom: 10px;
}

.message-row-own {
  justify-content: flex-end;
}

.message-row-other {
  justify-content: flex-start;
}

.message-bubble {
  max-width: min(68%, 560px);

  padding: 11px 14px 8px;

  border-radius: 18px;

  box-shadow:
    0 8px 22px rgba(0, 0, 0, 0.08);
}

.message-bubble p {
  margin: 0;

  color: #f5f7fa;

  font-size: 12px;
  line-height: 1.6;

  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.message-bubble-own {
  border-bottom-right-radius: 5px;

  background:
    linear-gradient(
      145deg,
      #82edbd,
      #65e6ae
    );

  box-shadow:
    0 9px 28px rgba(101, 230, 174, 0.07);
}

.message-bubble-own p {
  color: #06100b;
}

.message-bubble-other {
  border-bottom-left-radius: 5px;

  border: 1px solid rgba(255, 255, 255, 0.065);

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.065),
      rgba(255, 255, 255, 0.035)
    );
}

.message-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;

  margin-top: 5px;

  color: rgba(245, 247, 250, 0.32);

  font-size: 8px;
}

.message-bubble-own .message-meta {
  color: rgba(6, 16, 11, 0.5);
}

.message-read {
  font-weight: 800;
}

/* COMPOSER */

.chat-composer {
  position: relative;
  z-index: 3;

  display: flex;
  align-items: flex-end;
  gap: 9px;

  padding: 13px 16px 5px;

  border-top: 1px solid rgba(255, 255, 255, 0.055);

  background:
    linear-gradient(
      180deg,
      rgba(9, 16, 13, 0.5),
      rgba(9, 16, 13, 0.86)
    );
}

.chat-composer textarea {
  flex: 1;

  min-height: 45px;
  max-height: 140px;

  resize: none;

  padding: 13px 14px;

  border: 1px solid rgba(255, 255, 255, 0.075);
  outline: 0;

  border-radius: 14px;

  color: #f5f7fa;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.045),
      rgba(255, 255, 255, 0.022)
    );

  font-family: inherit;
  font-size: 12px;
  line-height: 1.45;

  transition:
    border-color 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.chat-composer textarea:focus {
  border-color: rgba(101, 230, 174, 0.25);

  background: rgba(255, 255, 255, 0.045);

  box-shadow:
    0 0 0 3px rgba(101, 230, 174, 0.035);
}

.chat-composer textarea::placeholder {
  color: rgba(245, 247, 250, 0.27);
}

.chat-composer button {
  width: 45px;
  height: 45px;

  flex: 0 0 auto;

  display: grid;
  place-items: center;

  border: 1px solid rgba(101, 230, 174, 0.18);
  border-radius: 14px;

  color: #06100b;

  background:
    linear-gradient(
      145deg,
      #82edbd,
      #65e6ae
    );

  font-size: 19px;
  font-weight: 900;

  cursor: pointer;

  box-shadow:
    0 10px 25px rgba(101, 230, 174, 0.07);

  transition:
    transform 0.2s ease,
    filter 0.2s ease,
    box-shadow 0.2s ease;
}

.chat-composer button:hover:not(:disabled) {
  transform: translateY(-2px);

  filter: brightness(1.04);

  box-shadow:
    0 13px 30px rgba(101, 230, 174, 0.12);
}

.chat-composer button:disabled {
  opacity: 0.28;

  cursor: not-allowed;

  box-shadow: none;
}

.chat-composer-hint {
  padding: 0 17px 11px;

  color: rgba(245, 247, 250, 0.2);

  font-size: 8px;

  text-align: right;
}

/* ERRORS */

.chat-error {
  margin: 0 16px 6px;

  padding: 9px 12px;

  border: 1px solid rgba(255, 90, 90, 0.14);
  border-radius: 10px;

  background: rgba(255, 70, 70, 0.04);

  color: rgba(255, 150, 150, 0.82);

  font-size: 10px;
}

/* EMPTY STATES */

.chat-empty-list,
.chat-no-messages {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;

  padding: 50px 25px;

  text-align: center;
}

.chat-empty-icon,
.chat-no-messages > div {
  position: relative;

  display: grid;
  place-items: center;

  width: 54px;
  height: 54px;

  margin-bottom: 15px;

  border: 1px solid rgba(101, 230, 174, 0.12);
  border-radius: 17px;

  color: #65e6ae;

  background: rgba(101, 230, 174, 0.055);
}

.chat-empty-list strong,
.chat-no-messages strong {
  color: rgba(255, 255, 255, 0.7);

  font-size: 12px;
}

.chat-empty-list span,
.chat-no-messages span {
  max-width: 240px;

  margin-top: 7px;

  color: rgba(245, 247, 250, 0.31);

  font-size: 10px;
  line-height: 1.65;
}

/* LOADING */

.chat-skeleton {
  height: 68px;

  margin: 4px 0;

  border: 1px solid rgba(255, 255, 255, 0.025);
  border-radius: 15px;

  background:
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.025),
      rgba(255, 255, 255, 0.06),
      rgba(255, 255, 255, 0.025)
    );

  background-size: 220% 100%;

  animation: chatSkeleton 1.7s infinite linear;
}

@keyframes chatSkeleton {
  from {
    background-position: 200% 0;
  }

  to {
    background-position: -20% 0;
  }
}

.chat-message-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;

  height: 100%;
}

.chat-message-loading span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #65e6ae;

  animation: chatDots 1s infinite ease-in-out;
}

.chat-message-loading span:nth-child(2) {
  animation-delay: 0.15s;
}

.chat-message-loading span:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes chatDots {
  0%,
  80%,
  100% {
    opacity: 0.25;
    transform: translateY(0);
  }

  40% {
    opacity: 1;
    transform: translateY(-5px);
  }
}

/* MOBILE */

@media (max-width: 760px) {
  .chat-page {
    min-height: 100vh;

    padding: 0;
  }

  .chat-shell {
    width: 100%;
    height: 100vh;
    min-height: 0;

    border: 0;
    border-radius: 0;

    grid-template-columns: 1fr;
  }

  .chat-sidebar {
    border-right: 0;
  }

  .chat-sidebar-hidden-mobile {
    display: none;
  }

  .chat-panel {
    display: none;
  }

  .chat-panel-mobile-open {
    display: flex;
  }

  .chat-sidebar-header {
    padding-top: 22px;
  }

  .chat-back-button {
    display: grid;
  }

  .chat-header {
    min-height: 68px;

    padding-left: 12px;
    padding-right: 12px;
  }

  .chat-messages {
    padding: 20px 12px;
  }

  .message-bubble {
    max-width: 84%;
  }

  .chat-composer {
    padding-left: 10px;
    padding-right: 10px;
  }

  .chat-composer-hint {
    display: none;
  }
}

@media (max-width: 420px) {
  .chat-sidebar-header h1 {
    font-size: 24px;
  }

  .chat-search {
    margin-left: 12px;
    margin-right: 12px;
  }

  .conversation-item {
    padding-left: 9px;
    padding-right: 9px;
  }

  .conversation-avatar,
  .chat-header-avatar {
    width: 42px;
    height: 42px;
  }

  .message-bubble {
    max-width: 88%;

    padding-left: 12px;
    padding-right: 12px;
  }
}

/* =========================================================
   TELEGRAM-STYLE CHAT REDESIGN
   Roamly visual layer
   ========================================================= */

.chat-page {
  padding: 0;
  background: #07100d;
}

.chat-shell {
  width: min(1280px, 100%);
  height: 100vh;
  min-height: 0;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  background: #07100d;
  grid-template-columns: 340px minmax(0, 1fr);
}

/* SIDEBAR */

.chat-sidebar {
  border-right: 1px solid rgba(255,255,255,.08);
  background: #0b1512;
}

.chat-sidebar::after {
  display: none;
}

.chat-sidebar-header {
  padding: 20px 18px 16px;
  border-bottom: 1px solid rgba(255,255,255,.06);
}

.chat-sidebar-header h1 {
  margin-top: 4px;
  font-size: 23px;
  letter-spacing: -.7px;
}

.chat-eyebrow {
  font-size: 8px;
  letter-spacing: 1.5px;
  color: rgba(101,230,174,.7);
}

.chat-online-dot {
  width: 7px;
  height: 7px;
  box-shadow: 0 0 0 3px rgba(101,230,174,.06);
}

/* SEARCH */

.chat-search {
  height: 42px;
  margin: 12px 12px 10px;
  padding: 0 13px;
  border-radius: 10px;
  background: #101c18;
  border-color: rgba(255,255,255,.055);
}

.chat-search:focus-within {
  background: #13211c;
  border-color: rgba(101,230,174,.2);
  box-shadow: 0 0 0 2px rgba(101,230,174,.025);
}

.chat-search span {
  font-size: 15px;
  opacity: .7;
}

.chat-search input {
  font-size: 12px;
}

/* CONVERSATION LIST */

.chat-conversation-list {
  padding: 2px 6px 12px;
}

.conversation-item {
  gap: 11px;
  padding: 10px 10px;
  margin-bottom: 1px;
  border-radius: 10px;
  border-color: transparent;
}

.conversation-item:hover {
  background: rgba(255,255,255,.035);
  border-color: transparent;
}

.conversation-item-active {
  background: rgba(101,230,174,.09);
  border-color: rgba(101,230,174,.04);
}

.conversation-item-active::before {
  display: none;
}

/* AVATAR */

.conversation-avatar,
.chat-header-avatar {
  width: 46px;
  height: 46px;
  border-radius: 50%;
