  border-color: rgba(101,230,174,.2);
  box-shadow: none;
}

.chat-composer button {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 0;
  background: #65e6ae;
  box-shadow: none;
  font-size: 17px;
}

.chat-composer button:hover:not(:disabled) {
  transform: none;
  filter: brightness(1.06);
  box-shadow: none;
}

.chat-composer-hint {
  padding: 0 14px 8px;
  font-size: 7px;
  color: rgba(245,247,250,.16);
}

/* EMPTY / LOADING */

.chat-empty-list,
.chat-no-messages {
  padding: 40px 20px;
}

.chat-empty-icon,
.chat-no-messages > div {
