@media (max-width: 420px) {
  .chat-sidebar-header h1 {
    font-size: 21px;
  }

  .conversation-avatar,
  .chat-header-avatar {
    width: 43px;
    height: 43px;
  }

  .message-bubble {
    max-width: 88%;
  }
}


/* =========================================================
   TELEGRAM-STYLE CSS ICONS
   ========================================================= */

.chat-search-icon {
  position: relative;
  width: 14px;
  height: 14px;
  display: block;
  flex: 0 0 auto;
  border: 1.7px solid rgba(245,247,250,.38);
  border-radius: 50%;
}

.chat-search-icon::after {
  content: "";
  position: absolute;
  width: 6px;
  height: 1.7px;
  right: -4px;
  bottom: -2px;
  border-radius: 999px;
  background: rgba(245,247,250,.38);
  transform: rotate(45deg);
  transform-origin: left center;
}

.chat-back-icon {
  position: relative;
  width: 16px;
  height: 16px;
  display: block;
  border-left: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(45deg) scale(.72);
}

.chat-welcome-orb {
  font-size: 0;
}

.chat-welcome-orb::after {
  display: block;
  width: 22px;
  height: 22px;
  border: 2px solid rgba(101,230,174,.72);
  border-radius: 50%;
  transform: none;
  box-sizing: border-box;
}

.chat-welcome-orb::before {
  display: block;
  width: 9px;
  height: 9px;
  border: 0;
  border-radius: 50%;
  background: #65e6ae;
  transform: none;
  box-shadow: 0 0 16px rgba(101,230,174,.35);
  z-index: 2;
}

.chat-empty-icon,
.chat-no-messages-icon {
  position: relative;
}

.chat-empty-icon::before,
.chat-no-messages-icon::before {
  content: "";
  width: 19px;
  height: 14px;
  display: block;
  border: 1.7px solid rgba(101,230,174,.7);
  border-radius: 5px;
}

.chat-empty-icon::after,
.chat-no-messages-icon::after {
  content: "";
  position: absolute;
  width: 6px;
  height: 6px;
  left: 15px;
  bottom: 14px;
  border-left: 1.7px solid rgba(101,230,174,.7);
  border-bottom: 1.7px solid rgba(101,230,174,.7);
  transform: skewY(-28deg);
}

.message-status {
  position: relative;
  display: inline-flex;
  align-items: center;
  width: 13px;
  height: 9px;
}

.message-check {
  position: absolute;
  width: 6px;
  height: 3px;
  left: 0;
  top: 2px;
  border-left: 1.4px solid currentColor;
  border-bottom: 1.4px solid currentColor;
  transform: rotate(-45deg);
}

.message-check-second {
  left: 4px;
}

.message-read {
  opacity: .8;
}

.send-icon {
  position: relative;
  width: 17px;
  height: 17px;
  display: block;
}

.send-icon::before {
  content: "";
  position: absolute;
  width: 13px;
  height: 13px;
  left: 1px;
  top: 1px;
  border-top: 2px solid currentColor;
  border-right: 2px solid currentColor;
  transform: rotate(45deg);
}

.send-icon::after {
  content: "";
  position: absolute;
  width: 15px;
  height: 2px;
  left: 0;
  top: 8px;
  border-radius: 999px;
  background: currentColor;
  transform: rotate(-45deg);
}

.send-loading {
  width: 14px;
  height: 14px;
  display: block;
  border: 2px solid rgba(6,16,11,.25);
  border-top-color: #06100b;
  border-radius: 50%;
  animation: chatSendSpin .7s linear infinite;
}

@keyframes chatSendSpin {
  to {
    transform: rotate(360deg);
  }
}


