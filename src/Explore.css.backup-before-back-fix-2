/* FILTER PANEL */

.filters {
  top: 28px;

  min-height: 410px;
  padding: 22px;

  border: 1px solid rgba(255, 255, 255, 0.085);
  border-radius: 22px;

  background:
    linear-gradient(
      150deg,
      rgba(255, 255, 255, 0.055),
      rgba(255, 255, 255, 0.016)
    );

  box-shadow:
    0 25px 70px rgba(0, 0, 0, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.filter-title {
  padding-bottom: 18px;
}

.filter-title strong {
  font-size: 14px;
}

.filter-title button {
  border-radius: 6px;

  transition:
    color 0.2s ease,
    background 0.2s ease;
}

.filter-title button:hover {
  background: rgba(101, 230, 174, 0.06);
}

.filter-group {
  gap: 12px;
  padding: 21px 0;
}

.filter-group > span {
  color: rgba(255, 255, 255, 0.36);
}

.filter-group label {
  min-height: 29px;
  padding: 4px 6px;

  margin: 0 -6px;

  border-radius: 7px;

  transition:
    color 0.2s ease,
    background 0.2s ease;
}

.filter-group label:hover {
  background: rgba(255, 255, 255, 0.035);
}

/* RESULTS */

.results-header {
  margin-bottom: 18px;
}

.results-header > div {
  gap: 5px;
}

.results-label {
  color: rgba(101, 230, 174, 0.72);
}

.results-header strong {
  font-size: 16px;
}

.sort-button {
  border-radius: 9px;

  transition:
    color 0.2s ease,
    background 0.2s ease;
}

.sort-button:hover {
  background: rgba(255, 255, 255, 0.035);
}

/* CARDS */

.opportunity-grid {
  gap: 22px;
}

.opportunity-card {
  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.055),
      rgba(255, 255, 255, 0.015)
    );

  box-shadow:
    0 24px 65px rgba(0, 0, 0, 0.17),
    inset 0 1px 0 rgba(255, 255, 255, 0.045);
}

.opportunity-card:hover {
  transform: translateY(-5px);

  border-color: rgba(101, 230, 174, 0.24);

  box-shadow:
    0 32px 75px rgba(0, 0, 0, 0.24),
    0 0 32px rgba(101, 230, 174, 0.035),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

/* ART */

.opportunity-image {
  height: 220px;
}

.opportunity-art {
  transition: transform 0.45s ease;
}

.opportunity-card:hover .opportunity-art {
  transform: scale(1.025);
}

.image-category {
  left: 16px;
  bottom: 16px;

  padding: 7px 10px;

  border-radius: 8px;
}

.favorite-button {
  top: 16px;
  right: 16px;

  width: 40px;
  height: 40px;
}

/* CONTENT */

.opportunity-content {
  padding: 21px;
}

.opportunity-location {
  margin-bottom: 11px;
}

.opportunity-content h2 {
  min-height: 49px;

  font-size: 20px;
  line-height: 1.25;
  letter-spacing: -0.5px;
}

.opportunity-meta {
  margin-top: 18px;
  gap: 7px;
}

.opportunity-meta span {
  padding: 7px 9px;

  border-radius: 8px;

  background: rgba(255, 255, 255, 0.025);
}

.view-button {
  margin-top: 20px;
  min-height: 45px;

  border-radius: 11px;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

/* STATES */

.explore-state {
  min-height: 280px;

  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.045),
      rgba(255, 255, 255, 0.012)
    );

  box-shadow:
    0 25px 65px rgba(0, 0, 0, 0.14),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

/* PAGINATION */

.explore-pagination {
  margin-top: 30px;
  padding-top: 22px;

  border-top: 1px solid rgba(255, 255, 255, 0.07);
}

/* TABLET */

@media (max-width: 900px) {
  .explore-page {
    width: min(100% - 40px, 760px);
    padding-top: 55px;
  }

  .explore-layout {
    grid-template-columns: 1fr;
  }

  .filters {
    display: none;
  }

  .opportunity-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* MOBILE */

@media (max-width: 600px) {
  .explore-page {
    width: calc(100% - 28px);
    padding-top: 38px;
    padding-bottom: 75px;
  }

  .explore-header {
    margin-bottom: 28px;
  }

  .explore-header h1 {
    font-size: clamp(45px, 14vw, 65px);
    line-height: 0.94;
    letter-spacing: -3px;
  }

  .explore-header p {
    margin-top: 20px;
    font-size: 13px;
    line-height: 1.7;
  }

  .search-section {
    gap: 10px;
    margin-bottom: 30px;
  }

  .search-box {
    height: 56px;
    border-radius: 14px;
  }

  .filter-button {
    width: 100%;
    height: 52px;
    border-radius: 14px;
  }

  .results-header {
    align-items: center;
    margin-bottom: 16px;
  }

  .results-header strong {
    font-size: 15px;
  }

  .opportunity-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .opportunity-card {
    border-radius: 19px;
  }

  .opportunity-image {
    height: 195px;
  }

  .opportunity-content {
    padding: 18px;
  }

  .opportunity-content h2 {
    min-height: auto;
    font-size: 19px;
  }

  .opportunity-meta {
    margin-top: 15px;
  }

  .view-button {
    margin-top: 17px;
  }
}

/* Final Back button */
.explore-back-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 38px;
  padding: 0 13px;
  margin-bottom: 18px;
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.045);
  color: #fff;
  font: inherit;
  font-size: 13px;
  line-height: 1;
  cursor: pointer;
  transition: background 140ms ease, border-color 140ms ease, transform 140ms ease;
}

.explore-back-button:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.16);
}

.explore-back-button:active {
  transform: translateY(1px);
}

.explore-back-button:focus-visible {
  outline: 2px solid rgba(74, 150, 117, 0.42);
  outline-offset: 2px;
}

@media (max-width: 600px) {
  .explore-back-button {
    min-height: 35px;
    margin-bottom: 14px;
    padding: 0 11px;
    border-radius: 8px;
    font-size: 12px;
  }
}
