      </p>

      <textarea
        value={applicationMessage}
        onChange={(event) =>
          setApplicationMessage(event.target.value)
        }
        placeholder="Write a message to the host..."
        maxLength={5000}
        rows={7}
      />

      {applyMessage && (
        <p className="apply-message" role="status">
