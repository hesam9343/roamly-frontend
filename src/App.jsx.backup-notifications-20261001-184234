function Home() {
  const { user, loading, logout } = useAuth();

  const [opportunities, setOpportunities] = useState([]);
  const [opportunitiesLoading, setOpportunitiesLoading] = useState(true);

  useEffect(() => {
    const controller = new AbortController();

    async function loadOpportunities() {
      try {
        setOpportunitiesLoading(true);

        const response = await fetch(
          "http://localhost:3000/api/opportunities?page=1&limit=6",
          {
            credentials: "include",
            signal: controller.signal,
          }
        );

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data?.error || "Failed to load opportunities.");
        }

        setOpportunities(
          Array.isArray(data.opportunities) ? data.opportunities : []
        );
      } catch (error) {
        if (error.name !== "AbortError") {
          console.error("Home opportunities error:", error);
        }
      } finally {
        if (!controller.signal.aborted) {
          setOpportunitiesLoading(false);
        }
      }
    }

    loadOpportunities();

    return () => controller.abort();
  }, []);

  const formatLocation = (opportunity) => {
    if (opportunity.city && opportunity.country) {
      return `${opportunity.city}, ${opportunity.country}`;
    }

    return opportunity.country || opportunity.city || "Location not specified";
  };

  return (
    <div className="app home-page">
      <nav className="navbar">
        <div className="navbar-top">
          <Link to="/" className="logo">
            Roamly
          </Link>

          <div className="nav-links">
            <Link to="/explore">Explore</Link>
            <a href="#how-it-works">How it works</a>
            <a href="#about">About</a>
          </div>

          <div className="nav-actions">
            {loading ? (
              <span className="nav-loading">Loading</span>
            ) : user ? (
              <>
                <Link to="/chat" className="nav-chat">
                  Chat
                </Link>

                <Link to="/profile" className="nav-user">
                  <span className="nav-user-dot" />
                  <span>Profile</span>
                </Link>

                <button
                  type="button"
                  className="nav-logout"
                  onClick={logout}
                >
                  Log out
                </button>
              </>
            ) : (
              <>
                <Link to="/auth" className="login-button">
                  Log in
                </Link>

                <Link to="/auth" className="signup-button">
                  Sign up
                </Link>
              </>
            )}
          </div>
        </div>
      </nav>

      <main>
        <section className="home-hero">
          <div className="home-hero-content">
            <span className="home-kicker">
              TRAVEL · SKILLS · PEOPLE
            </span>

            <h1>
              Find a place.
              <br />
              <span>Share what you know.</span>
            </h1>

            <p>
              Roamly connects travelers with people around the world
              through meaningful skill exchanges, local experiences,
              and real human connections.
            </p>

            <div className="home-search">
              <div className="home-search-field">
                <span className="home-search-label">WHERE</span>
                <span className="home-search-value">
                  Explore destinations
                </span>
              </div>

              <div className="home-search-divider" />

              <div className="home-search-field">
                <span className="home-search-label">WHAT YOU CAN DO</span>
                <span className="home-search-value">
                  Share your skills
                </span>
              </div>

              <Link to="/explore" className="home-search-button">
                Explore
                <span>→</span>
              </Link>
            </div>

            <div className="home-hero-note">
              <span className="home-note-dot" />
              Discover opportunities created by real hosts
            </div>
          </div>

          <div className="home-hero-side">
            <div className="home-hero-image">
              <div className="home-image-overlay" />

              <div className="home-floating-card home-floating-card-top">
                <span className="home-floating-label">
                  ROAMLY
                </span>
                <strong>Go somewhere<br />worth remembering.</strong>
              </div>

              <div className="home-floating-card home-floating-card-bottom">
                <span className="home-floating-location">
                  GLOBAL COMMUNITY
                </span>
                <strong>Stay. Help. Connect.</strong>
              </div>
            </div>
          </div>
        </section>

        <section className="home-opportunities" id="about">
          <div className="home-section-heading">
            <div>
              <span className="home-section-kicker">
                FROM THE COMMUNITY
              </span>

              <h2>
                Places looking for
                <br />
                <em>people like you.</em>
              </h2>
            </div>

            <Link to="/explore" className="home-section-link">
              View all opportunities →
            </Link>
          </div>

          {opportunitiesLoading ? (
            <div className="home-opportunity-state">
              Loading opportunities...
            </div>
          ) : opportunities.length === 0 ? (
            <div className="home-opportunity-state">
              No opportunities are available yet.
            </div>
          ) : (
            <div className="home-opportunity-grid">
              {opportunities.map((opportunity) => (
                <Link
                  key={opportunity.id}
                  to={`/opportunity/${opportunity.id}`}
                  className="home-opportunity-card"
                >
                  <div className="home-opportunity-art">
                    <span>
                      {opportunity.category || "Opportunity"}
                    </span>
                  </div>

                  <div className="home-opportunity-content">
                    <span className="home-opportunity-location">
                      {formatLocation(opportunity)}
                    </span>

                    <h3>{opportunity.title}</h3>

                    <p>
                      {opportunity.description ||
                        "A meaningful opportunity to travel, help and connect."}
                    </p>

                    <div className="home-opportunity-meta">
                      {opportunity.accommodation && (
                        <span>Stay included</span>
                      )}

                      {opportunity.food && (
                        <span>Food included</span>
                      )}

                      {opportunity.wifi && (
                        <span>Wi-Fi</span>
                      )}
                    </div>
                  </div>
                </Link>
              ))}
            </div>
          )}
        </section>

        <section className="home-how" id="how-it-works">
          <div className="home-how-heading">
            <span className="home-section-kicker">
              HOW ROAMLY WORKS
            </span>

            <h2>
              One idea.
              <br />
              <em>Many ways to travel.</em>
            </h2>
          </div>

          <div className="home-how-grid">
            <article>
              <span>01</span>
              <h3>Discover</h3>
              <p>
                Search places, hosts and opportunities that match
                the kind of experience you want.
              </p>
            </article>

            <article>
              <span>02</span>
              <h3>Connect</h3>
              <p>
                Talk directly with hosts and understand the
                opportunity before you travel.
              </p>
            </article>

            <article>
              <span>03</span>
              <h3>Exchange</h3>
              <p>
                Bring your time and skills and receive a place
                to stay, local experience, or another agreed exchange.
              </p>
            </article>
          </div>
        </section>

        <section className="home-host-cta">
          <div>
            <span className="home-section-kicker">
              HAVE A PLACE TO SHARE?
            </span>

            <h2>
              Turn your space into
              <br />
              <em>an experience.</em>
            </h2>

            <p>
              Meet travelers, exchange skills and create something
              meaningful around the place you call home.
            </p>
          </div>

          <Link to="/auth" className="home-host-button">
            Become a host
            <span>→</span>
          </Link>
        </section>
      </main>
    </div>
  );
}

